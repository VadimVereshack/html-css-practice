<style>
.slider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    margin-top: 50px;
  }
  
  .slider-images {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 600px; /* ширина видимой области */
    overflow: hidden;
    position: relative;
  }
  
  .slider-images img {
    width: 200px;
    flex-shrink: 0;
    transition: transform 0.3s;
    opacity: 0.5; /* боковые изображения полупрозрачные */
  }
  
  .slider-images img.active {
    transform: scale(1.2);
    opacity: 1; /* центральное изображение крупнее и полностью видно */
  }
  
  button {
    font-size: 24px;
    padding: 10px 15px;
    cursor: pointer;
  }
</style>

<div class="slider">
    <button id="prev">&lt;</button>
    
    <div class="slider-images">
        <img src="./img/1.png" alt="img" width="200">
        <img src="./img/2.png" alt="img" width="200">
        <img src="./img/3.png" alt="img" width="200">
        <img src="./img/4.png" alt="img" width="200">
    </div>
    
    <button id="next">&gt;</button>
  </div>



  <script>
    const images = document.querySelectorAll('.slider-images img');
const prevBtn = document.getElementById('prev');
const nextBtn = document.getElementById('next');

let current = 0;

function updateSlider() {
  images.forEach((img, index) => {
    img.classList.remove('active');
    if (index === current) img.classList.add('active');
  });
}

prevBtn.addEventListener('click', () => {
  current = (current - 1 + images.length) % images.length;
  updateSlider();
});

nextBtn.addEventListener('click', () => {
  current = (current + 1) % images.length;
  updateSlider();
});

// Инициализация
updateSlider();

 </script>

